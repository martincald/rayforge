{"nodes": [{"id": "sculpfun_c1_device_sculpfun_c1", "label": "Sculpfun C1 Device Profile", "file_type": "code", "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sculpfun_c1_device_device_profile_schema", "label": "Device Profile Schema v1", "file_type": "concept", "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every bundled device ships an api_version-stamped device.yaml with the same shape (device metadata block + machine block holding driver, gcode_precision, axis_extents, origin, speed caps and a heads list). Versioning the schema lets Rayforge evolve the profile format without invalidating community-contributed device files, and the uniform shape means adding hardware support is a data change rather than a code change."}, {"id": "sculpfun_c1_device_grblserialdriver", "label": "GrblSerialDriver", "file_type": "concept", "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default transport for hobby diode engravers: GRBL firmware over USB serial. Profiles tune it per machine through driver_args (baudrate, poll_status_while_running) and driver_config (rx_buffer_size) rather than by subclassing, so one driver covers the whole GRBL fleet."}, {"id": "sculpfun_c1_device_bottom_left_origin", "label": "Bottom-Left Origin Convention", "file_type": "concept", "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every GRBL diode machine in this chunk declares origin: bottom_left, matching the mathematical Y-up convention GRBL firmware assumes. The profile records it so the workpiece-to-machine coordinate transform can flip Y only where the hardware disagrees."}], "edges": [{"source": "sculpfun_c1_device_sculpfun_c1", "target": "sculpfun_c1_dialect_gcode_dialect", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": null, "weight": 1.0}, {"source": "sculpfun_c1_device_sculpfun_c1", "target": "sculpfun_c1_device_grblserialdriver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": "machine.driver", "weight": 1.0}, {"source": "sculpfun_c1_device_sculpfun_c1", "target": "sculpfun_c1_device_device_profile_schema", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": null, "weight": 1.0}, {"source": "sculpfun_c1_device_sculpfun_c1", "target": "sculpfun_c1_device_bottom_left_origin", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml", "source_location": "machine.origin", "weight": 1.0}], "hyperedges": [{"id": "grbl_serial_device_family", "label": "GRBL Serial Device Family", "nodes": ["sculpfun_c1_device_grblserialdriver", "sculpfun_c1_device_sculpfun_c1", "sculpfun_icube_ultra_device_sculpfun_icube_ultra", "sculpfun_icube_device_sculpfun_icube", "sculpfun_s30_pro_max_device_sculpfun_s30_pro_max", "sculpfun_s30_device_sculpfun_s30", "sculpfun_s40_max_device_sculpfun_s40_max", "sculpfun_s70_max_device_sculpfun_s70_max", "twotrees_tts55_device_twotrees_tts_55"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/device.yaml"}]}