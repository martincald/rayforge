{"nodes": [{"id": "sculpfun_c1_dialect_gcode_dialect", "label": "Sculpfun C1 G-code Dialect", "file_type": "code", "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sculpfun_c1_dialect_per_move_power_mode", "label": "Per-Move Laser Power Mode", "file_type": "rationale", "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Older or bandwidth-limited controllers get 'M4 S{power}' emitted as its own command, motion templates without {s_command}, and modal_feedrate/can_g0_with_speed disabled so every G1 repeats its F word. Slower and more verbose than continuous mode, but safe on firmware that mishandles inline S on G0 or drops modal state after a buffer flush. These dialects also define a dwell template (G4 P), which the continuous-mode dialects omit."}, {"id": "sculpfun_c1_dialect_wcs_offset_injection", "label": "WCS Offset Injection After Preamble", "file_type": "rationale", "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "inject_wcs_after_preamble makes the generator emit the 'G10 L2 P{p_num}' work-coordinate offset immediately after G21/G90 rather than leaving it to persisted controller state. Machines that do not home reliably or that lose their WCS between power cycles need the offset restated at job start so the job lands where the UI previewed it."}, {"id": "sculpfun_c1_dialect_grbl_jog_protocol", "label": "GRBL Jog Protocol", "file_type": "concept", "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual motion uses GRBL's '$J=' jog commands (absolute G90 form for move_to, incremental G91 form for jog) instead of plain G0. Jog commands can be cancelled mid-motion and do not disturb modal state or the job planner, so interactive UI moves cannot corrupt a queued job."}], "edges": [{"source": "sculpfun_c1_dialect_gcode_dialect", "target": "sculpfun_c1_dialect_per_move_power_mode", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": "continuous_laser_mode", "weight": 1.0}, {"source": "sculpfun_c1_dialect_per_move_power_mode", "target": "sculpfun_s30_pro_max_dialect_continuous_laser_mode", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "sculpfun_c1_dialect_gcode_dialect", "target": "sculpfun_c1_dialect_wcs_offset_injection", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": "inject_wcs_after_preamble", "weight": 1.0}, {"source": "sculpfun_c1_dialect_wcs_offset_injection", "target": "sculpfun_c1_dialect_per_move_power_mode", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "sculpfun_c1_dialect_gcode_dialect", "target": "sculpfun_c1_dialect_grbl_jog_protocol", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": "move_to, jog", "weight": 1.0}, {"source": "sculpfun_c1_dialect_gcode_dialect", "target": "sculpfun_s30_pro_max_dialect_gcode_dialect", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml", "source_location": "focus_laser_on", "weight": 1.0}], "hyperedges": [{"id": "per_move_power_dialect_family", "label": "Per-Move Power Dialect Family", "nodes": ["sculpfun_c1_dialect_per_move_power_mode", "sculpfun_c1_dialect_wcs_offset_injection", "sculpfun_c1_dialect_gcode_dialect", "sculpfun_icube_ultra_dialect_gcode_dialect", "sculpfun_icube_dialect_gcode_dialect", "sculpfun_s30_dialect_gcode_dialect", "xtool_d1_pro_dialect_gcode_dialect"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-c1/dialect.yaml"}]}