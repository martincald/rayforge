{"nodes": [{"id": "atomstack_a70_dialect_atomstack_a70", "label": "Atomstack A70 G-code Dialect", "file_type": "document", "source_file": "rayforge/resources/devices/atomstack-a70/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "atomstack_a70_dialect_continuous_laser_mode", "label": "Continuous Laser Mode with Modal Feedrate", "file_type": "rationale", "source_file": "rayforge/resources/devices/atomstack-a70/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomstack dialects set `laser_on: M4 S0` and instead append {s_command} to every move template, with continuous_laser_mode and modal_feedrate both true. The laser is armed once and power is modulated per move, and unchanged feedrates are suppressed, producing far shorter G-code than re-issuing M4/M5 and F per segment. They also set can_g0_with_speed true so travel moves may carry F."}], "edges": [{"source": "atomstack_a70_dialect_atomstack_a70", "target": "acmer_p3_dialect_gcode_dialect_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/atomstack-a70/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "atomstack_a70_dialect_atomstack_a70", "target": "atomstack_a70_dialect_continuous_laser_mode", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/atomstack-a70/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "atomstack_a70_dialect_continuous_laser_mode", "target": "acmer_p3_dialect_m4_dynamic_power_mode", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "rayforge/resources/devices/atomstack-a70/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "atomstack_a70_dialect_atomstack_a70", "target": "atomstack_x