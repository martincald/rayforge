{"nodes": [{"id": "rayforge_addon_sketcher_rayforge_addon_sketcher", "label": "Sketcher Addon Manifest", "file_type": "document", "source_file": "rayforge/builtin_addons/rayforge-addon-sketcher/rayforge-addon.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": "Rayforge Team", "contributor": null}, {"id": "rayforge_addon_sketcher_rayforge_addon_worker_frontend_split", "label": "Addon Worker/Frontend Split", "file_type": "rationale", "source_file": "rayforge/builtin_addons/rayforge-addon-sketcher/rayforge-addon.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Addons declare entry points under `provides` as separate `worker` and `frontend` module paths. The split lets headless compute (sketcher.worker, post_processors.worker, core_materials.worker) load in a background process without pulling in GTK, while UI-only addons such as print_and_cut declare a frontend and no worker at all. An addon may declare either, both, or a bare module path (tool_library declares `worker: tool_library`)."}], "edges": [{"source": "rayforge_addon_sketcher_rayforge_addon_sketcher", "target": "rayforge_addon_sketcher_rayforge_addon_worker_frontend_split", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/builtin_addons/rayforge-addon-sketcher/rayforge-addon.yaml", "source_location": null, "weight": 1.0}, {"source": "rayforge_addon_sketcher_rayforge_addon_sketcher", "target": "rayforge_addon_materials_rayforge_addon_api_version_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/builtin_addons/rayforge-addon-sketcher/rayforge-addon.yaml", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "builtin_addon_manifest_registry", "label": "Builtin Addon Manifest Registry", "nodes": ["rayforge_addon_materials_rayforge_addon_core_materials", "rayforge_addon_post_rayforge_add