{"nodes": [{"id": "carvera_dialect_carvera", "label": "Carvera G-code Dialect", "file_type": "document", "source_file": "rayforge/resources/devices/carvera/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "carvera_dialect_smoothieware_wcs_preamble", "label": "Smoothieware Inline WCS Preamble", "file_type": "rationale", "source_file": "rayforge/resources/devices/carvera/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carvera dialects interpolate the work coordinate system directly into the preamble via `G00 {machine.active_wcs}` and therefore set inject_wcs_after_preamble false, unlike the GRBL profiles which leave it true and let the generator inject WCS. They also bracket the job with the Carvera-specific M321/M322 pair, use G28 for per-axis homing and M999 (not $X) to clear alarms, and use G10 L20 rather than L2 for WCS offsets."}], "edges": [{"source": "carvera_dialect_carvera", "target": "acmer_p3_dialect_gcode_dialect_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/carvera/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "carvera_dialect_carvera", "target": "carvera_dialect_smoothieware_wcs_preamble", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/carvera/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "carvera_dialect_carvera", "target": "carvera_air_dialect_carvera_air", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/carvera/dialect.yaml", "source_location": null, "weight": 1.0}], "hyperedges": []}