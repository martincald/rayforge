{"nodes": [{"id": "sculpfun_icube_device_sculpfun_icube", "label": "Sculpfun iCube Device Profile", "file_type": "code", "source_file": "rayforge/resources/devices/sculpfun-icube/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sculpfun_icube_device_rx_buffer_flow_control", "label": "RX Buffer Size Flow Control", "file_type": "rationale", "source_file": "rayforge/resources/devices/sculpfun-icube/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The iCube declares driver_config.rx_buffer_size: 31 instead of GRBL's usual 127-byte serial receive buffer. The character-counting flow-control loop must not stream more bytes than the controller can hold, so under-declaring the buffer trades throughput for not overflowing a firmware that reports the standard size but cannot honour it."}], "edges": [{"source": "sculpfun_icube_device_sculpfun_icube", "target": "sculpfun_icube_dialect_gcode_dialect", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/sculpfun-icube/device.yaml", "source_location": null, "weight": 1.0}, {"source": "sculpfun_icube_device_sculpfun_icube", "target": "sculpfun_c1_device_grblserialdriver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-icube/device.yaml", "source_location": "machine.driver", "weight": 1.0}, {"source": "sculpfun_icube_device_sculpfun_icube", "target": "sculpfun_c1_device_device_profile_schema", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/sculpfun-icube/device.yaml", "source_location": null, "weight": 1.0}, {"source": "sculpfun_icube_device_sculpfun_icube", "target": "sculpfun_c1_device_bottom_left_origin", "relation": "implements", "confiden