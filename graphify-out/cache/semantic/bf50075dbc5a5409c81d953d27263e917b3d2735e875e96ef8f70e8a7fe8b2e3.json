{"nodes": [{"id": "creality_falcon_10w_dialect_grbl_dialect", "label": "Creality Falcon 10W GRBL Dialect", "file_type": "code", "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "creality_falcon_10w_dialect_continuous_laser_mode", "label": "Continuous Laser Mode", "file_type": "rationale", "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dialects that set continuous_laser_mode:true emit 'M4 S0' once and then carry power inline via {s_command} on every G0/G1/G2/G3. This relies on GRBL's dynamic-power (M4) laser mode so power scales with actual feed rate during acceleration, avoiding burn-in at corners. Controllers without true M4 laser mode (Elidor Z6, MKS DLC32, OMTech K40+) instead set continuous_laser_mode:false and emit an explicit power argument on the laser_on command."}, {"id": "creality_falcon_10w_dialect_modal_feedrate", "label": "Modal Feedrate Emission", "file_type": "rationale", "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "modal_feedrate:true (paired with omit_unchanged_coords and can_g0_with_speed) lets the generator drop the F word when the feed rate has not changed, shrinking the G-code stream for serial-bandwidth-limited controllers. Dialects that set it false (Elidor Z6, MKS DLC32, OMTech K40+) re-emit F on every move because their firmware does not reliably retain modal state."}], "edges": [{"source": "creality_falcon_10w_dialect_grbl_dialect", "target": "creality_falcon_10w_dialect_continuous_laser_mode", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "creality_falcon_10w_dialect_grbl_dialect", "target": "creality_falcon_10w_dialect_modal_feedrate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml", "source_location": null, "weight": 1.0}, {"source": "creality_falcon_10w_dialect_continuous_laser_mode", "target": "creality_falcon_10w_dialect_modal_feedrate", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "identical_grbl_diode_dialect_template", "label": "Byte-Identical GRBL Diode Dialect Template", "nodes": ["creality_falcon_10w_dialect_grbl_dialect", "creality_falcon_a1_dialect_grbl_dialect", "longer_ray5_dialect_grbl_dialect", "neje_master_3_max_dialect_grbl_dialect", "ortur_laser_master_3_dialect_grbl_dialect", "ortur_laser_master_4_dialect_grbl_dialect"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/creality-falcon-10w/dialect.yaml"}]}