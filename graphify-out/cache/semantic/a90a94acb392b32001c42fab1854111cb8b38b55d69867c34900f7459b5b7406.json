{"nodes": [{"id": "acmer_p3_device_acmer_p3", "label": "Acmer P3 Device Profile", "file_type": "document", "source_file": "rayforge/resources/devices/acmer-p3/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "acmer_p3_device_grblserialdriver", "label": "GrblSerialDriver", "file_type": "concept", "source_file": "rayforge/resources/devices/acmer-p3/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named driver class selected by device profiles that talk GRBL over a serial link. Configured through `driver_args` (baudrate, poll_status_while_running), so per-machine transport quirks stay in data rather than in driver code."}, {"id": "acmer_p3_device_multi_head_tool_change", "label": "Dual-Head Tool Change Addressing", "file_type": "rationale", "source_file": "rayforge/resources/devices/acmer-p3/device.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acmer P3 defines two diode heads distinguished by tool_number 0 and 1, and zeroes frame_power_percent/focus_power_percent on the infrared head because that head cannot be safely used for framing or focusing. The tool_number is what the dialect's `tool_change: T{tool_number}` template interpolates. Carvera uses the same field with sentinel values (-1 for its laser, 8888 on Carvera Air) rather than an index."}], "edges": [{"source": "acmer_p3_device_acmer_p3", "target": "acmer_p3_dialect_acmer_p3", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/resources/devices/acmer-p3/device.yaml", "source_location": null, "weight": 1.0}, {"source": "acmer_p3_device_acmer_p3", "target": "acmer_p3_device_grblserialdriver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/acmer-p3/dev