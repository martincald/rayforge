{"nodes": [{"id": "sculpfun_s30_pro_max_dialect_gcode_dialect", "label": "Sculpfun S30 Pro Max G-code Dialect", "file_type": "code", "source_file": "rayforge/resources/devices/sculpfun-s30-pro-max/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sculpfun_s30_pro_max_dialect_continuous_laser_mode", "label": "Continuous Laser Mode", "file_type": "rationale", "source_file": "rayforge/resources/devices/sculpfun-s30-pro-max/dialect.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The laser is armed once with 'M4 S0' and every subsequent motion word carries its own inline {s_command}, with modal_feedrate and can_g0_with_speed both enabled. Keeping GRBL in dynamic-power (M4) mode for the whole job avoids per-segment M3/M5 toggling, which would stall the planner and burn overshoot marks at corners; inline S also lets raster power vary per move without extra lines."}], "edges": [{"source": "sculpfun_s30_pro_max_dialect_gcode_dialect", "target": "sculpfun_s30_pro_max_dialect_continuous_laser_mode", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-s30-pro-max/dialect.yaml", "source_location": "continuous_laser_mode", "weight": 1.0}, {"source": "sculpfun_s30_pro_max_dialect_gcode_dialect", "target": "sculpfun_c1_dialect_grbl_jog_protocol", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/resources/devices/sculpfun-s30-pro-max/dialect.yaml", "source_location": "move_to, jog", "weight": 1.0}], "hyperedges": []}