{"nodes": [{"id": "materials_cardboard", "label": "Cardboard Material", "file_type": "document", "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "materials_material_definition_schema", "label": "Material Definition Schema", "file_type": "concept", "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every material file in the addon uses an identical five-key shape (uid, name, description, category, appearance). Keeping one material per YAML file with a stable uid lets the addon be extended by dropping in a new file without touching code, and makes the uid the join key between the catalog and machine/laser settings elsewhere in Rayforge."}, {"id": "materials_localization_schema", "label": "Seven-Locale Localization Schema", "file_type": "concept", "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "name, description and category are each maps with a 'default' key plus de/es/fr/pt/uk/zh_CN translations. Inlining translations in the data file (rather than routing them through gettext .po catalogs) keeps addon-supplied content translatable without recompiling the app's message catalogs; 'default' acts as the fallback when a locale is missing."}, {"id": "materials_appearance_block", "label": "Appearance Block (color + pattern)", "file_type": "concept", "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each material carries a hex color and one of a small closed set of render patterns (solid, wood_grain, metallic, transparent) so the canvas can draw a recognizable stock preview without per-material texture assets."}, {"id": "materials_category_paper", "label": "Paper Category", "file_type": "concept", "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "materials_pattern_solid", "label": "Solid Render Pattern", "file_type": "concept", "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "materials_cardboard", "target": "materials_category_paper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "weight": 1.0}, {"source": "materials_cardboard", "target": "materials_pattern_solid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "weight": 1.0}, {"source": "materials_cardboard", "target": "materials_material_definition_schema", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "weight": 1.0}, {"source": "materials_material_definition_schema", "target": "materials_localization_schema", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "rayforge/builtin_addons/rayforge-addon-materials/materials/cardboard.yaml", "source_location": null, "weight": 1.0}, {"source": "materials_material_definition_schema", "target": "materials_appearance_blo